rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email']) &&
        data.keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    function isValidVerificationBookmark(data) {
      return data.keys().hasAll(['userId', 'qrvid', 'status']) &&
        data.keys().hasOnly(['bookmarkId', 'userId', 'qrvid', 'status', 'notes', 'pinned', 'verifiedAt', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.qrvid is string && data.qrvid.size() <= 128 && data.qrvid.matches('^QRV-[A-Z0-9][A-Z0-9-]{2,127}$') &&
        data.status is string && data.status in ['VALID', 'REVOKED', 'NOT_FOUND', 'PENDING', 'UNKNOWN'] &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        (!('pinned' in data) || data.pinned is bool);
    }

    function isValidVerificationRecord(data) {
      return data.keys().hasAll(['recordId', 'qrvid', 'status', 'timestamp']) &&
        data.keys().hasOnly(['recordId', 'qrvid', 'status', 'issuer', 'timestamp', 'latencyMs', 'resolvedBy']) &&
        data.recordId is string && data.recordId.size() <= 128 && data.recordId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.qrvid is string && data.qrvid.size() <= 128 && data.qrvid.matches('^QRV-[A-Z0-9][A-Z0-9-]{2,127}$') &&
        data.status is string && data.status in ['VALID', 'REVOKED', 'NOT_FOUND', 'EXPIRED', 'PENDING'] &&
        data.timestamp is string && data.timestamp.size() <= 50 &&
        (!('issuer' in data) || (data.issuer is string && data.issuer.size() <= 128)) &&
        (!('latencyMs' in data) || data.latencyMs is number) &&
        (!('resolvedBy' in data) || (data.resolvedBy is string && data.resolvedBy.size() <= 64));
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if false;

      // User's private bookmarked verifications and audit notes
      match /bookmarks/{bookmarkId} {
        allow get: if isOwner(userId) && isValidId(bookmarkId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(bookmarkId) && isValidVerificationBookmark(incoming()) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(bookmarkId) && isValidVerificationBookmark(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(bookmarkId);
      }
    }

    // Public Recent Verification History & Telemetry
    match /verification_history/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if true;
      allow create: if isValidId(recordId) && isValidVerificationRecord(incoming());
      allow update, delete: if false; // Append-only immutable telemetry audit log
    }
  }
}
