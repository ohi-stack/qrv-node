{
  "name": "qrv-node",
  "version": "2.3.0",
  "description": "Consolidated QR-V browser platform with the production Global Verification Network design",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check scripts/live-acceptance.mjs && node --check scripts/production-check.mjs && node --test",
    "test": "node --test",
    "build": "npm run check",
    "smoke": "node -e \"const base=process.env.QRV_NODE_URL||'http://127.0.0.1:3000'; Promise.all(['/healthz','/readyz','/version'].map(p=>fetch(base+p).then(async r=>({status:r.status,body:await r.json()})))).then(console.log)\"",
    "acceptance:live": "node scripts/live-acceptance.mjs",
    "validate:prod": "npm run build && node scripts/production-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "qrcode": "^1.5.4"
  }
}
