{
  "name": "qrv-node",
  "version": "2.0.0",
  "description": "Consolidated QR-V browser platform for qrv.network, backed only by api.qrv.network",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check scripts/live-acceptance.mjs",
    "build": "npm run check",
    "smoke": "node -e \"const base=process.env.QRV_NODE_URL||'http://127.0.0.1:3000'; Promise.all(['/healthz','/readyz','/version'].map(p=>fetch(base+p).then(async r=>({status:r.status,body:await r.json()})))).then(console.log)\"",
    "acceptance:live": "node scripts/live-acceptance.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
