{
  "name": "qrv-node",
  "version": "0.2.1",
  "description": "Canonical QR-V Network root node for qrv.network: production public routes, service directory, verification handoff, health checks, and deployment metadata.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check scripts/live-acceptance.mjs",
    "smoke": "node -e \"const base=process.env.QRV_NODE_URL||'http://127.0.0.1:3000'; Promise.all(['/healthz','/readyz','/version'].map(p=>fetch(base+p).then(r=>r.json()))).then(console.log)\"",
    "acceptance:live": "node scripts/live-acceptance.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.19.2"
  }
}
