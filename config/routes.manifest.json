  "criticalRoutes": [
    {
      "route": "/verify/:qrvid",
      "tier": 1,
      "surface": "public",
      "owner": "qrv-node",
      "backend": "GET /api/v1/verify/{qrvid}",
      "authentication": "public",
      "protocol": "QRVP-1",
      "standard": "QVS-1.0",
      "requiredTests": [
        "VERIFIED",
        "REVOKED",
        "EXPIRED",
        "NOT_FOUND",
        "UNAVAILABLE"
      ]
    },
    {
      "route": "/issuer/records/new",
      "tier": 1,
      "surface": "issuer",
      "owner": "qrv-node",
      "backend": "POST /api/v1/certificates",
      "authentication": "issuer",
      "protocol": "QRVP-1",
      "standard": "QVS-1.0"
    },
    {
      "route": "/registry/:qrvid",
      "tier": 1,
      "surface": "public",
      "owner": "qrv-node",
      "backend": "GET /api/v1/registry/{qrvid}",
      "authentication": "public",
      "protocol": "QRVP-1",
      "standard": "QVS-1.0"
    }
  ],
  "legacyRedirects": {
    "verify.qrv.network": "/verify",
    "registry.qrv.network": "/registry",
    "issuer.qrv.network": "/issuer",
    "docs.qrv.network": "/docs",
    "developers.qrv.network": "/developers",
    "explorer.qrv.network": "/registry"
  },
  "apiPolicy": {
    "machineOriented": true,
    "sourceOfTruth": "OpenAPI",
    "operational": [
      "/healthz",
      "/readyz",
      "/version",
      "/metrics"
    ],
    "families": [
      "status",
      "verify",
      "registry",
      "issuers",
      "certificates",
      "contact-cards",
      "analytics",
      "audit",
      "webhooks",
      "keys"
    ]
  },
  "capabilityRule": {
    "definedRouteDoesNotEqualOperationalCapability": true,
    "productionRequires": [
      "implemented",
      "integrated",
      "documented",
      "tested",
      "repeatable"
    ]
  },
  "qrEncodingTemplate": "https://qrv.network/verify/{QRVID}"
