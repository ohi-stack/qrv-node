# QR-V™ Production Architecture v1.0 — PUBLIC PLATFORM NODE
# Runtime: https://qrv.network
# This service owns human-facing UI/workflows only.
# NEVER place DATABASE_URL, SUPABASE_SECRET_KEY, signing private keys,
# webhook secrets, payment-provider secrets, or database-admin credentials here.

NODE_ENV=production
PORT=3000
APP_VERSION=1.2.0

# Canonical public platform origin.
APP_BASE_URL=https://qrv.network
QRV_PLATFORM_ORIGIN=https://qrv.network

# Canonical machine/API dependency. Do not point this back to qrv.network/api/v1.
API_BASE_URL=https://api.qrv.network/api/v1
QRV_API_BASE_URL=https://api.qrv.network/api/v1

# Canonical browser-facing routes.
VERIFY_BASE_URL=https://qrv.network/verify
REGISTRY_BASE_URL=https://qrv.network/registry
ISSUER_BASE_URL=https://qrv.network/issuer
DOCS_BASE_URL=https://qrv.network/docs
DEVELOPERS_BASE_URL=https://qrv.network/developers
STATUS_BASE_URL=https://qrv.network/status

# Public-only values embedded into the Vite/React customer-facing bundle.
# Never place secrets in VITE_* variables.
VITE_APP_BASE_URL=https://qrv.network
VITE_QRV_VERIFY_BASE_URL=https://qrv.network/verify
VITE_QRV_ISSUER_BASE_URL=https://qrv.network/issuer
VITE_QRV_API_BASE_URL=https://api.qrv.network/api/v1
VITE_QRV_REGISTRY_BASE_URL=https://qrv.network/registry
VITE_QRV_DOCS_BASE_URL=https://qrv.network/docs
VITE_QRV_DEVELOPERS_BASE_URL=https://qrv.network/developers
VITE_QRV_STATUS_BASE_URL=https://qrv.network/status
VITE_QRV_DEMO_QRVID=QRV-PROD-CERT-000001

# Optional local web-development port. Production still binds the Express runtime to PORT.
WEB_PORT=5173

# Server-to-server write authorization. Must match api.qrv.network.
# Server-side only; never expose to browser JavaScript or VITE_ variables.
QRV_PLATFORM_API_KEY=

# Issuer Portal pilot authentication on qrv.network/issuer.
# Replace/extend the access-code model with issuer-scoped identity/RBAC before
# enterprise multi-tenant deployment.
SESSION_SECRET=
ISSUER_ACCESS_CODE=
SESSION_TTL_MS=43200000

LOG_LEVEL=info
