NODE_ENV=production
PORT=3000
SERVICE_NAME=qrv-platform
SERVICE_VERSION=2.2.0
QRV_PUBLIC_BASE_URL=https://qrv.network
QRV_API_BASE_URL=https://api.qrv.network/api/v1
DEMO_QRVID=QRV-PROD-CERT-000001
QRV_API_TIMEOUT_MS=7000
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=240
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=8
QRV_WRITE_API_KEY=
QRV_ISSUER_ID=
QRV_ISSUER_NAME=
ISSUER_PORTAL_USERNAME=
# Format: salt:128-character scrypt hex output
ISSUER_PORTAL_PASSWORD_SCRYPT=
# Minimum 32 characters
ISSUER_SESSION_SECRET=
ISSUER_SESSION_TTL_SECONDS=28800
LOG_LEVEL=info
