NODE_ENV=production
PORT=3000
APP_VERSION=1.0.0

# Canonical public platform.
QRV_PLATFORM_ORIGIN=https://qrv.network
APP_BASE_URL=https://qrv.network

# Canonical backend. qrv.network must call api.qrv.network directly.
QRV_API_BASE_URL=https://api.qrv.network/api/v1
API_BASE_URL=https://api.qrv.network/api/v1

# Canonical browser-facing routes.
VERIFY_BASE_URL=https://qrv.network/verify
REGISTRY_BASE_URL=https://qrv.network/registry
ISSUER_BASE_URL=https://qrv.network/issuer
DOCS_BASE_URL=https://qrv.network/docs
DEVELOPERS_BASE_URL=https://qrv.network/developers
STATUS_BASE_URL=https://qrv.network/status

# Server-to-server authorization only. Must match api.qrv.network.
# Never expose this value to browser JavaScript.
QRV_PLATFORM_API_KEY=

# Issuer Portal authentication on qrv.network/issuer.
SESSION_SECRET=
ISSUER_ACCESS_CODE=
SESSION_TTL_MS=43200000

# qrv.network MUST NOT contain DATABASE_URL, SUPABASE_SECRET_KEY,
# signing private keys, webhook secrets, or database-admin credentials.
