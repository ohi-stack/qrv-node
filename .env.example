# QR-V™ Production Architecture v1.0 — PUBLIC PLATFORM NODE
# Runtime: https://qrv.network
# This service owns human-facing UI/workflows only.
# NEVER place DATABASE_URL, SUPABASE_SECRET_KEY, signing private keys,
# webhook secrets, payment-provider secrets, or database-admin credentials here.

NODE_ENV=production
PORT=3000
APP_VERSION=1.0.0

# Canonical public platform origin.
QRV_PLATFORM_ORIGIN=https://qrv.network

# Canonical machine/API dependency. Do not point this back to qrv.network/api/v1.
QRV_API_BASE_URL=https://api.qrv.network/api/v1

# Server-to-server write authorization. Must match api.qrv.network.
# Server-side only; never expose to browser JavaScript or NEXT_PUBLIC_/VITE_ variables.
QRV_PLATFORM_API_KEY=

# Issuer Portal pilot authentication on qrv.network/issuer.
# Replace/extend the access-code model with issuer-scoped identity/RBAC before
# enterprise multi-tenant deployment.
SESSION_SECRET=
ISSUER_ACCESS_CODE=
SESSION_TTL_MS=43200000

# Canonical browser routes (documentation only):
# https://qrv.network/verify
# https://qrv.network/registry
# https://qrv.network/issuer
# https://qrv.network/explorer
# https://qrv.network/docs
# https://qrv.network/developers
# https://qrv.network/status
