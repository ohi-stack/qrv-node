NODE_ENV=production
PORT=3000
APP_VERSION=1.0.0

# Canonical platform + API.
QRV_PLATFORM_ORIGIN=https://qrv.network
QRV_API_BASE_URL=https://api.qrv.network/api/v1

# Server-to-server authorization. Must match api.qrv.network.
QRV_PLATFORM_API_KEY=

# Issuer Portal authentication on qrv.network/issuer.
SESSION_SECRET=
ISSUER_ACCESS_CODE=
SESSION_TTL_MS=43200000
